---
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Claude関連YouTube動画の要点を毎日まとめるブリーフ" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/logo.svg")} />
    <link rel="icon" type="image/png" href={withBase("/logo.png")} />
    <title>{title}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-line/70 bg-paper/70 backdrop-blur">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
          <a href={withBase("/")} class="flex items-center gap-3 text-ink">
            <img src={withBase("/logo.png")} alt="Claude Daily" class="h-10 w-10 object-contain" onerror={`this.onerror=null; this.src='${withBase("/logo.svg")}'`} />
            <span class="flex items-baseline gap-3">
              <span class="text-xl font-bold tracking-tight">Claude Daily</span>
              <span class="hidden text-xs uppercase tracking-[0.3em] text-clay md:inline">brief</span>
            </span>
          </a>
          <p class="hidden text-sm text-clay md:block">Claude関連YouTubeを毎日まとめる</p>
        </div>
      </header>
      <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
        <slot />
      </main>
      <footer class="border-t border-line/70 bg-paper/50 py-8 text-center text-xs leading-7 text-clay">
        Claude Daily — 自動要約のため正確性は保証されません。出典は各記事末尾に記載しています。
      </footer>
    </div>
  </body>
</html>
