---
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "Claude・Claude Code・Anthropic・MCPに関するYouTube動画を毎日収集し、日本語で要点だけ読めるダイジェストにまとめます。AIエージェント・LLMの最新トピックを短時間でキャッチアップできます。",
  path,
  image,
  type = "website",
  publishedTime,
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.claude-daily.com");
const currentPath = path ?? Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteUrl).toString();
const socialImage = image ? new URL(image, siteUrl).toString() : new URL(withBase("/logo.png"), siteUrl).toString();
const robotsContent = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const structuredDataPayload = structuredData ? JSON.stringify(structuredData) : undefined;
const rssUrl = new URL(withBase("/rss.xml"), siteUrl).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#efe5d8" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Claude Daily" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Claude Daily RSS" href={rssUrl} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="icon" type="image/svg+xml" href={withBase("/logo.svg")} />
    <link rel="icon" type="image/png" href={withBase("/logo.png")} />
    <title>{title}</title>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
    {adsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}
    {structuredDataPayload && <script type="application/ld+json" set:html={structuredDataPayload} />}
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-line/70 bg-paper/70 backdrop-blur">
        <div class="mx-auto flex max-w-[86rem] items-center justify-between px-6 py-4 xl:px-8">
          <a href={withBase("/")} class="flex items-center gap-3 text-ink">
            <img src={withBase("/logo.png")} alt="Claude Daily" class="h-10 w-10 object-contain" onerror={`this.onerror=null; this.src='${withBase("/logo.svg")}'`} />
            <span class="flex items-baseline gap-3">
              <span class="text-xl font-bold tracking-tight">Claude Daily</span>
              <span class="hidden text-xs uppercase tracking-[0.3em] text-clay md:inline">brief</span>
            </span>
          </a>
          <div class="flex items-center gap-4">
            <p class="hidden text-sm text-clay md:block">Claude関連YouTubeを毎日まとめる</p>
            <a
              href={withBase("/rss.xml")}
              class="rounded-full border border-line bg-paper px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-clay transition hover:border-coral hover:text-coralDark"
            >
              RSS
            </a>
          </div>
        </div>
      </header>
      <main class="mx-auto w-full max-w-[86rem] flex-1 px-6 py-12 xl:px-8">
        <slot />
      </main>
      <footer class="border-t border-line/70 bg-paper/50 py-8 text-center text-xs leading-7 text-clay">
        <p>Claude Daily — 自動要約のため正確性は保証されません。出典は各記事末尾に記載しています。</p>
        <nav class="mt-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
          <a href={withBase("/about/")} class="underline hover:text-coral">About</a>
          <span aria-hidden="true">·</span>
          <a href={withBase("/topics/")} class="underline hover:text-coral">Topics</a>
          <span aria-hidden="true">·</span>
          <a href={withBase("/notes/")} class="underline hover:text-coral">編集メモ</a>
          <span aria-hidden="true">·</span>
          <a href={withBase("/editorial-policy/")} class="underline hover:text-coral">Editorial Policy</a>
          <span aria-hidden="true">·</span>
          <a href={withBase("/privacy/")} class="underline hover:text-coral">プライバシーポリシー</a>
          <span aria-hidden="true">·</span>
          <a href={withBase("/rss.xml")} class="underline hover:text-coral">RSS</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
