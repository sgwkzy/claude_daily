---
import "../styles/global.css";
import { withBase } from "../lib/url";
import {
  getLocaleFromUrl,
  htmlLang,
  localePath,
  locales,
  ogLocale,
  t,
  toBasePath,
  type Locale,
} from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  locale?: Locale;
}

const {
  title,
  description = "Daily English & Japanese digests of YouTube videos about Claude, Claude Code, Anthropic, and MCP. Catch up on the latest AI agent and LLM topics in minutes.",
  path,
  image,
  type = "website",
  publishedTime,
  noindex = false,
  structuredData,
  locale = getLocaleFromUrl(Astro.url),
} = Astro.props;

const tr = t(locale);
const siteUrl = Astro.site ?? new URL("https://claude-daily.com");
// `path` はロケール非依存のベースパス。未指定なら現在 URL から /jp を剥がして求める。
const basePath = path ?? toBasePath(Astro.url.pathname);
const localizedHref = (loc: Locale) => withBase(localePath(basePath, loc));
const canonicalUrl = new URL(localizedHref(locale), siteUrl).toString();
const alternateLinks = locales.map((loc) => ({
  hreflang: htmlLang[loc],
  href: new URL(localizedHref(loc), siteUrl).toString(),
}));
const xDefaultHref = new URL(localizedHref("en"), siteUrl).toString();
const socialImage = image ? new URL(image, siteUrl).toString() : new URL(withBase("/logo.png"), siteUrl).toString();
const robotsContent = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const structuredDataPayload = structuredData ? JSON.stringify(structuredData) : undefined;
const rssUrl = new URL(withBase(localePath("/rss.xml", locale)), siteUrl).toString();
const jaHref = localizedHref("ja");
const enHref = localizedHref("en");
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700;900&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#efe5d8" />
    <script is:inline define:vars={{ currentLocale: locale, jaHref, enHref }}>
      // 初回訪問時のブラウザ言語による自動判定 + 手動選択の保持。
      // 保存済みの選択があれば最優先、無ければルート(英語)で ja ブラウザのみ /jp へ誘導する。
      (function () {
        try {
          var stored = localStorage.getItem("preferred-lang");
          if (stored === "ja" && currentLocale !== "ja") { location.replace(jaHref); return; }
          if (stored === "en" && currentLocale !== "en") { location.replace(enHref); return; }
          if (!stored && currentLocale === "en") {
            var lang = (navigator.language || navigator.userLanguage || "").toLowerCase();
            if (lang.indexOf("ja") === 0) { location.replace(jaHref); }
          }
        } catch (e) {}
      })();
    </script>
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:site_name" content="Claude Daily" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <link rel="alternate" type="application/rss+xml" title="Claude Daily RSS" href={rssUrl} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="icon" type="image/svg+xml" href={withBase("/logo.svg")} />
    <link rel="icon" type="image/png" href={withBase("/logo.png")} />
    <title>{title}</title>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
    {adsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}
    {structuredDataPayload && <script type="application/ld+json" set:html={structuredDataPayload} />}
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-line/70 bg-paper/70 backdrop-blur">
        <div class="mx-auto flex max-w-[86rem] items-center justify-between px-6 py-4 xl:px-8">
          <a href={withBase("/")} class="flex items-center gap-3 text-ink">
            <img src={withBase("/logo.png")} alt="Claude Daily" class="h-10 w-10 object-contain" onerror={`this.onerror=null; this.src='${withBase("/logo.svg")}'`} />
            <span class="flex items-baseline gap-3">
              <span class="text-xl font-bold tracking-tight">Claude Daily</span>
              <span class="hidden text-xs uppercase tracking-[0.3em] text-clay md:inline">brief</span>
            </span>
          </a>
          <div class="flex items-center gap-4">
            <p class="hidden text-sm text-clay lg:block">{tr("site.tagline")}</p>
            <div class="flex items-center rounded-full border border-line bg-paper text-xs font-semibold" aria-label={tr("lang.switchLabel")}>
              <a
                href={enHref}
                data-set-lang="en"
                aria-current={locale === "en" ? "true" : undefined}
                class={`rounded-full px-3 py-1.5 transition ${locale === "en" ? "bg-coral text-paper" : "text-clay hover:text-coralDark"}`}
              >
                {tr("lang.en")}
              </a>
              <a
                href={jaHref}
                data-set-lang="ja"
                aria-current={locale === "ja" ? "true" : undefined}
                class={`rounded-full px-3 py-1.5 transition ${locale === "ja" ? "bg-coral text-paper" : "text-clay hover:text-coralDark"}`}
              >
                {tr("lang.ja")}
              </a>
            </div>
            <a
              href={withBase(localePath("/rss.xml", locale))}
              class="rounded-full border border-line bg-paper px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-clay transition hover:border-coral hover:text-coralDark"
            >
              {tr("nav.rss")}
            </a>
          </div>
        </div>
      </header>
      <main class="mx-auto w-full max-w-[86rem] flex-1 px-6 py-12 xl:px-8">
        <slot />
      </main>
      <footer class="border-t border-line/70 bg-paper/50 py-8 text-center text-xs leading-7 text-clay">
        <p>{tr("footer.disclaimer")}</p>
        <nav class="mt-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
          <a href={withBase(localePath("/about/", locale))} class="underline hover:text-coral">{tr("nav.about")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/topics/", locale))} class="underline hover:text-coral">{tr("nav.topics")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/archive/", locale))} class="underline hover:text-coral">{tr("nav.archive")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/notes/", locale))} class="underline hover:text-coral">{tr("nav.notes")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/editorial-policy/", locale))} class="underline hover:text-coral">{tr("nav.editorialPolicy")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/privacy/", locale))} class="underline hover:text-coral">{tr("nav.privacy")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/contact/", locale))} class="underline hover:text-coral">{tr("nav.contact")}</a>
          <span aria-hidden="true">·</span>
          <a href={withBase(localePath("/rss.xml", locale))} class="underline hover:text-coral">{tr("nav.rss")}</a>
        </nav>
      </footer>
    </div>
    <script is:inline>
      // 言語トグルのクリックで選択を保存（次回以降の自動判定より優先される）。
      document.querySelectorAll("[data-set-lang]").forEach(function (el) {
        el.addEventListener("click", function () {
          try {
            localStorage.setItem("preferred-lang", el.getAttribute("data-set-lang"));
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>
