---
import ArticleCard from "./ArticleCard.astro";
import {
  buildArticlePath,
  formatDateLabel,
  formatShortDate,
  getLocalizedDescription,
  getArticleId,
  localizeArticleData,
  type ResolvedDay,
} from "../lib/articles";
import { localePath, t, type Locale } from "../i18n/ui";
import { withBase } from "../lib/url";

interface Props {
  day: ResolvedDay;
  totalDays: number;
  allDates: string[];
  latestDate: string;
  locale?: Locale;
}

const { day, allDates, latestDate, locale = "ja" } = Astro.props;
const tr = t(locale);
const prevHref = day.prevDate ? withBase(localePath(`/days/${day.prevDate}/`, locale)) : undefined;
const nextHref = day.nextDate ? withBase(localePath(`/days/${day.nextDate}/`, locale)) : undefined;
const dateLabel = formatDateLabel(day.date, locale);
const latestLabel = formatDateLabel(latestDate, locale);
const hrefFor = (date: string) =>
  date === latestDate ? withBase(localePath("/", locale)) : withBase(localePath(`/days/${date}/`, locale));
---

<section class="mb-12">
  <p class="text-xs font-semibold uppercase tracking-[0.32em] text-coral">{tr("index.lastBrief")} · {latestLabel}</p>
  <h1 class="headline mt-5 text-4xl font-black leading-[1.22] text-ink md:text-[3rem]">
    {tr("index.heroTitleA")}<br class="hidden md:inline" />{tr("index.heroTitleB")}
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-[1.95] text-ink/75">
    {tr("index.heroSubtitleA")}<br class="hidden md:inline" />{tr("index.heroSubtitleB")}
  </p>
</section>

<section class="mb-8">
  <nav
    class="flex items-center justify-center gap-3 rounded-full border border-line/70 bg-paper px-2 py-2 shadow-card sm:grid sm:grid-cols-[1fr_auto_1fr] sm:justify-normal"
    aria-label={tr("nav.dateAria")}
  >
    <div class="hidden justify-self-start sm:block">
      {prevHref ? (
        <a
          href={prevHref}
          class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold text-clay transition hover:bg-cream hover:text-ink"
          aria-label={tr("index.noPrev")}
        >
          <span aria-hidden="true">←</span>
          <span>{formatShortDate(day.prevDate!)}</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-2 px-4 py-2 text-xs text-clay/40">
          <span aria-hidden="true">←</span>
          <span>{tr("index.noPrev")}</span>
        </span>
      )}
    </div>

    <details class="date-picker group relative justify-self-center">
      <summary class="flex cursor-pointer list-none flex-col items-center rounded-full px-5 py-1.5 text-center transition hover:bg-cream">
        <span class="text-[0.65rem] uppercase tracking-[0.32em] text-coral">{tr("index.dailyBrief")}</span>
        <span class="mt-0.5 inline-flex items-center gap-1.5 text-sm font-bold text-ink">
          {dateLabel}
          <span class="text-[0.6rem] text-clay" aria-hidden="true">▼</span>
        </span>
      </summary>
      <div class="date-picker-panel absolute left-1/2 top-full z-20 mt-3 w-[min(18rem,calc(100vw-2rem))] -translate-x-1/2 rounded-2xl border border-line/70 bg-paper p-2 shadow-slide">
        <p class="px-3 py-2 text-[0.65rem] uppercase tracking-[0.28em] text-clay">{tr("index.datesWithArticles")}</p>
        <ul class="max-h-72 space-y-0.5 overflow-auto pb-1">
          {allDates.map((d) => (
            <li>
              <a
                href={hrefFor(d)}
                class={`flex items-center justify-between rounded-xl px-3 py-2 text-sm transition ${
                  d === day.date
                    ? "bg-coral font-semibold text-paper"
                    : "text-ink hover:bg-cream"
                }`}
              >
                <span>{formatDateLabel(d, locale)}</span>
                {d === latestDate && d !== day.date && (
                  <span class="text-[0.6rem] uppercase tracking-[0.18em] text-clay">{tr("index.latest")}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <div class="hidden justify-self-end sm:block">
      {nextHref ? (
        <a
          href={nextHref}
          class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold text-clay transition hover:bg-cream hover:text-ink"
          aria-label={tr("index.noNext")}
        >
          <span>{formatShortDate(day.nextDate!)}</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-2 px-4 py-2 text-xs text-clay/40">
          <span>{tr("index.noNext")}</span>
          <span aria-hidden="true">→</span>
        </span>
      )}
    </div>
  </nav>
</section>

<section class="mb-14 rounded-slide border border-line/70 bg-paper p-7 shadow-card md:p-9">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">{tr("index.pickups")}</p>
    <p class="text-xs text-clay">{day.articles.length} {tr("unit.items")}</p>
  </div>
  <ol class="mt-5 divide-y divide-line/60">
    {day.articles.map((article, index) => {
      const loc = localizeArticleData(article, locale);
      return (
      <li>
        <a
          href={`#article-${getArticleId(article)}`}
          class="group flex items-start gap-4 py-4 transition hover:bg-cream/40"
        >
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-coral/40 text-sm font-bold text-coral">{String(index + 1).padStart(2, "0")}</span>
          <div class="flex-1 space-y-1">
            <p class="headline text-base font-bold leading-snug text-ink group-hover:text-coralDark md:text-lg">{loc.articleTitle}</p>
            <p class="text-xs text-clay">{article.data.channel} · {loc.keyPhrases.slice(0, 3).map((p) => `#${p}`).join(" ")}</p>
          </div>
          <span class="mt-1 text-clay/60 group-hover:text-coral" aria-hidden="true">↓</span>
        </a>
      </li>
      );
    })}
  </ol>
</section>

<section class="space-y-10">
  {day.articles.map((article) => {
    const loc = localizeArticleData(article, locale);
    return (
    <div id={`article-${getArticleId(article)}`} class="scroll-mt-24">
      <ArticleCard
        articleId={getArticleId(article)}
        articlePath={buildArticlePath(article)}
        title={loc.articleTitle}
        channel={article.data.channel}
        headerImage={loc.headerImage}
        publishedAt={article.data.fetchedAt}
        keyPhrases={loc.keyPhrases}
        bulletPoints={loc.bulletPoints}
        summary={getLocalizedDescription(article, locale)}
        locale={locale}
      />
    </div>
    );
  })}
</section>

<style>
  .date-picker > summary::-webkit-details-marker {
    display: none;
  }
  .date-picker > summary::marker {
    content: "";
  }
</style>

<script>
  // 外側クリック・Escapeで日付ピッカーを閉じる
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    document.querySelectorAll<HTMLDetailsElement>("details.date-picker[open]").forEach((details) => {
      if (!details.contains(target)) {
        details.open = false;
      }
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      document.querySelectorAll<HTMLDetailsElement>("details.date-picker[open]").forEach((details) => {
        details.open = false;
      });
    }
  });
</script>
