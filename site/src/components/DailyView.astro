---
import ArticleCard from "./ArticleCard.astro";
import { formatDateLabel, formatShortDate, type ResolvedDay } from "../lib/articles";
import { withBase } from "../lib/url";

interface Props {
  day: ResolvedDay;
  totalDays: number;
  allDates: string[];
  latestDate: string;
}

const { day, allDates, latestDate } = Astro.props;
const prevHref = day.prevDate ? withBase(`/days/${day.prevDate}/`) : undefined;
const nextHref = day.nextDate ? withBase(`/days/${day.nextDate}/`) : undefined;
const dateLabel = formatDateLabel(day.date);
const latestLabel = formatDateLabel(latestDate);
const hrefFor = (date: string) => (date === latestDate ? withBase("/") : withBase(`/days/${date}/`));
---

<section class="mb-12">
  <p class="text-xs font-semibold uppercase tracking-[0.32em] text-coral">LAST BRIEF · {latestLabel}</p>
  <h1 class="headline mt-5 text-4xl font-black leading-[1.22] text-ink md:text-[3rem]">
    Claudeを語る動画を、<br class="hidden md:inline" />読むだけで掴む。
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-[1.95] text-ink/75">
    Claude・Claude Code・Anthropic・MCPに関する動画を毎日収集し、字幕からスライド風の日本語まとめを自動生成しています。
  </p>
</section>

<section class="mb-8">
  <nav
    class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 rounded-full border border-line/70 bg-paper px-2 py-2 shadow-card"
    aria-label="日付ナビゲーション"
  >
    <div class="justify-self-start">
      {prevHref ? (
        <a
          href={prevHref}
          class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold text-clay transition hover:bg-cream hover:text-ink"
          aria-label="前日のブリーフへ"
        >
          <span aria-hidden="true">←</span>
          <span>{formatShortDate(day.prevDate!)}</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-2 px-4 py-2 text-xs text-clay/40">
          <span aria-hidden="true">←</span>
          <span>前日なし</span>
        </span>
      )}
    </div>

    <details class="date-picker group relative justify-self-center">
      <summary class="flex cursor-pointer list-none flex-col items-center rounded-full px-5 py-1.5 text-center transition hover:bg-cream">
        <span class="text-[0.65rem] uppercase tracking-[0.32em] text-coral">Daily Brief</span>
        <span class="mt-0.5 inline-flex items-center gap-1.5 text-sm font-bold text-ink">
          {dateLabel}
          <span class="text-[0.6rem] text-clay" aria-hidden="true">▼</span>
        </span>
      </summary>
      <div class="date-picker-panel absolute left-1/2 top-full z-20 mt-3 w-72 -translate-x-1/2 rounded-2xl border border-line/70 bg-paper p-2 shadow-slide">
        <p class="px-3 py-2 text-[0.65rem] uppercase tracking-[0.28em] text-clay">記事のある日付</p>
        <ul class="max-h-72 space-y-0.5 overflow-auto pb-1">
          {allDates.map((d) => (
            <li>
              <a
                href={hrefFor(d)}
                class={`flex items-center justify-between rounded-xl px-3 py-2 text-sm transition ${
                  d === day.date
                    ? "bg-coral font-semibold text-paper"
                    : "text-ink hover:bg-cream"
                }`}
              >
                <span>{formatDateLabel(d)}</span>
                {d === latestDate && d !== day.date && (
                  <span class="text-[0.6rem] uppercase tracking-[0.18em] text-clay">最新</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <div class="justify-self-end">
      {nextHref ? (
        <a
          href={nextHref}
          class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold text-clay transition hover:bg-cream hover:text-ink"
          aria-label="翌日のブリーフへ"
        >
          <span>{formatShortDate(day.nextDate!)}</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-2 px-4 py-2 text-xs text-clay/40">
          <span>翌日なし</span>
          <span aria-hidden="true">→</span>
        </span>
      )}
    </div>
  </nav>
</section>

<section class="mb-14 rounded-slide border border-line/70 bg-paper p-7 shadow-card md:p-9">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">本日のピックアップ</p>
    <p class="text-xs text-clay">{day.articles.length} 件</p>
  </div>
  <ol class="mt-5 divide-y divide-line/60">
    {day.articles.map((article, index) => (
      <li>
        <a
          href={`#article-${article.id}`}
          class="group flex items-start gap-4 py-4 transition hover:bg-cream/40"
        >
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-coral/40 text-sm font-bold text-coral">{String(index + 1).padStart(2, "0")}</span>
          <div class="flex-1 space-y-1">
            <p class="headline text-base font-bold leading-snug text-ink group-hover:text-coralDark md:text-lg">{article.data.title}</p>
            <p class="text-xs text-clay">{article.data.channel} · {article.data.keyPhrases.slice(0, 3).map((p) => `#${p}`).join(" ")}</p>
          </div>
          <span class="mt-1 text-clay/60 group-hover:text-coral" aria-hidden="true">↓</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<section class="space-y-10">
  {day.articles.map((article) => (
    <div id={`article-${article.id}`} class="scroll-mt-24">
      <ArticleCard
        articleId={article.id}
        title={article.data.title}
        channel={article.data.channel}
        headerImage={article.data.headerImage}
        publishedAt={article.data.publishedAt}
        keyPhrases={article.data.keyPhrases}
        bulletPoints={article.data.bulletPoints}
      />
    </div>
  ))}
</section>

<style>
  .date-picker > summary::-webkit-details-marker {
    display: none;
  }
  .date-picker > summary::marker {
    content: "";
  }
</style>

<script>
  // 外側クリック・Escapeで日付ピッカーを閉じる
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    document.querySelectorAll<HTMLDetailsElement>("details.date-picker[open]").forEach((details) => {
      if (!details.contains(target)) {
        details.open = false;
      }
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      document.querySelectorAll<HTMLDetailsElement>("details.date-picker[open]").forEach((details) => {
        details.open = false;
      });
    }
  });
</script>
