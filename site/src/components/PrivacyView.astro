---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localePath, type Locale } from "../i18n/ui";
import { withBase } from "../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === "en";
const lastUpdated = "2026-06-14";
const contactHref = withBase(localePath("/contact/", locale));
const description = isEn
  ? "Claude Daily privacy policy. How we use analytics (Google Analytics), advertising (Google AdSense), and cookies."
  : "Claude Daily のプライバシーポリシー。アクセス解析(Google Analytics)・広告配信(Google AdSense)・Cookie の利用状況を記載します。";
---

<BaseLayout title={isEn ? "Privacy Policy | Claude Daily" : "プライバシーポリシー | Claude Daily"} description={description} path="/privacy/" locale={locale}>
  <article class="mx-auto max-w-[52rem] space-y-10 leading-[1.95] text-ink/85">
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">Privacy</p>
      <h1 class="headline mt-3 text-3xl font-black leading-tight text-ink md:text-4xl">{isEn ? "Privacy Policy" : "プライバシーポリシー"}</h1>
      <p class="mt-3 text-xs text-clay">{isEn ? "Last updated" : "最終更新"}: {lastUpdated}</p>
    </header>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "1. Operator" : "1. 運営者"}</h2>
      <p>
        {isEn
          ? "This site, Claude Daily (\"the Site\"), is an independently operated information digest site. It is not affiliated with Claude / Anthropic."
          : "本サイト Claude Daily（以下「当サイト」）は、個人運営の情報まとめサイトです。Claude / Anthropic 公式とは関係ありません。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "2. Information we collect" : "2. 当サイトが収集する情報"}</h2>
      <p>
        {isEn
          ? "The Site automatically collects the following information to understand visitor usage and improve the service:"
          : "当サイトは、訪問者の利用状況の把握およびサービス改善のために、以下の情報を自動的に収集します。"}
      </p>
      <ul class="list-disc space-y-2 pl-6">
        {isEn ? (
          <>
            <li>Device information such as browser type and version, OS, and screen size</li>
            <li>Referring URL, time on site, and pages viewed</li>
            <li>Approximate regional information (country / region level)</li>
            <li>Anonymous identifiers assigned by cookies and similar technologies</li>
          </>
        ) : (
          <>
            <li>ブラウザの種類とバージョン、OS、画面サイズ等の端末情報</li>
            <li>アクセス元の参照 URL、滞在時間、閲覧したページ</li>
            <li>おおまかな地域情報（国・都道府県単位）</li>
            <li>Cookie および類似技術によって付与される匿名識別子</li>
          </>
        )}
      </ul>
      <p>
        {isEn
          ? "The Site does not collect personally identifying information such as name or email address, except where you actively send it (e.g., inquiries)."
          : "当サイトは氏名・メールアドレスなどの個人を特定する情報を、お問い合わせ等の能動的な送信を除いて取得しません。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "3. Analytics tools" : "3. アクセス解析ツールについて"}</h2>
      <p>
        {isEn
          ? "The Site uses \"Google Analytics 4,\" an analytics tool provided by Google LLC. Google Analytics uses cookies to collect traffic data, but the data collected is anonymized and does not identify individuals."
          : "当サイトは Google LLC が提供するアクセス解析ツール「Google Analytics 4」を利用しています。Google Analytics はトラフィックデータの収集のために Cookie を使用しますが、収集されるデータは匿名化されており、個人を特定するものではありません。"}
      </p>
      <p>
        {isEn ? "You can refuse this collection by disabling cookies. For details, see " : "この機能は Cookie を無効にすることで収集を拒否できます。詳細は "}
        <a class="underline hover:text-coral" href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noreferrer">{isEn ? "Google's partner sites policy" : "Google のパートナーサイトポリシー"}</a>
        {isEn ? "." : " をご確認ください。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "4. Third-party advertising" : "4. 第三者配信広告サービスについて"}</h2>
      <p>
        {isEn
          ? "The Site may use the third-party advertising service \"Google AdSense.\" Third-party vendors such as AdSense use cookies to display ads deemed appropriate based on a user's past visits to this and other sites."
          : "当サイトは第三者配信の広告サービス「Google AdSense」を利用することがあります。AdSense などの第三者配信事業者は Cookie を使用して、ユーザーがそのウェブサイトや他のサイトに過去にアクセスした際の情報に基づき、適切と思われる広告を表示します。"}
      </p>
      <p>
        {isEn ? "You can disable personalized ads from " : "パーソナライズド広告は "}
        <a class="underline hover:text-coral" href="https://www.google.com/settings/ads" target="_blank" rel="noreferrer">{isEn ? "Google Ads Settings" : "Google の広告設定"}</a>
        {isEn ? ". You can also opt out of other third-party cookies at " : " から無効化できます。また、その他第三者の Cookie 無効化は "}
        <a class="underline hover:text-coral" href="https://optout.aboutads.info/" target="_blank" rel="noreferrer">aboutads.info</a>
        {isEn ? "." : " から行えます。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "5. Copyright and citation" : "5. 著作権・引用について"}</h2>
      <p>
        {isEn
          ? "The Site mechanically summarizes transcripts of videos published on YouTube and organizes the key points into articles. Each article body clearly states the source video's title, channel, publish date, and URL; copyright of the original video belongs to its rights holder."
          : "当サイトは YouTube 上で公開されている動画の字幕を機械的に要約し、要点を日本語の記事として整理しています。各記事の本文には引用元の動画タイトル・チャンネル名・公開日時・URL を明記しており、元動画の著作権は各動画の権利者に帰属します。"}
      </p>
      <p>
        {isEn
          ? "Because our summaries are machine-generated, we do not guarantee their accuracy. To verify what was said in the original video, please watch it via the source link at the end of each article."
          : "当サイトの要約は機械生成のため、内容の正確性を保証するものではありません。元動画の発言内容を確認したい場合は、各記事末尾の出典リンクから元動画をご視聴ください。"}
      </p>
      <p>
        {isEn
          ? "If you are a rights holder and have concerns about an article on the Site, please contact us at the address below. We will respond promptly."
          : "引用元の権利者の方で当サイトの記事掲載に問題がある場合は、後述の連絡先までご連絡ください。速やかに対応いたします。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "6. Disclaimer" : "6. 免責事項"}</h2>
      <p>
        {isEn
          ? "We do our best to ensure the accuracy and completeness of information on the Site but do not guarantee it. The Site is not responsible for any decisions or actions taken based on its information."
          : "当サイトに掲載された情報の正確性・完全性については最善を尽くしますが、保証するものではありません。当サイトの情報に基づく一切の判断・行動について、当サイトは責任を負いません。"}
      </p>
      <p>
        {isEn
          ? "The Site is not responsible for the content of external sites it links to."
          : "当サイトからリンクしている外部サイトの内容については、当サイトは責任を負いません。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "7. Revisions" : "7. 改定について"}</h2>
      <p>
        {isEn
          ? "This policy may be revised without notice as needed. Revised content takes effect once posted on the Site."
          : "本ポリシーは、必要に応じて予告なく改定することがあります。改定後の内容は当サイトに掲載した時点から効力を生じます。"}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-ink">{isEn ? "8. Contact" : "8. お問い合わせ"}</h2>
      <p>
        {isEn ? "For inquiries about this policy or the Site, please email " : "本ポリシー、または当サイトに関するお問い合わせは、メール "}
        <a class="underline hover:text-coral" href="mailto:sugawalabo@gmail.com">sugawalabo@gmail.com</a>
        {isEn ? " or the operator's X account " : " または運営者の X アカウント "}
        <a class="underline hover:text-coral" href="https://x.com/sugawalabo" target="_blank" rel="noreferrer">@sugawalabo</a>
        {isEn ? ". For details, see the " : " へお願いいたします。窓口の詳細は "}
        <a class="underline hover:text-coral" href={contactHref}>{isEn ? "Contact page" : "お問い合わせページ"}</a>
        {isEn ? "." : " をご確認ください。"}
      </p>
    </section>
  </article>
</BaseLayout>
