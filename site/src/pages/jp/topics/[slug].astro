---
import TopicView from "../../../components/TopicView.astro";
import { loadTopicGroups } from "../../../lib/articles";

export async function getStaticPaths() {
  const topics = await loadTopicGroups("ja");
  return topics.map((topic) => ({ params: { slug: topic.slug } }));
}

const { slug } = Astro.params;
---

<TopicView slug={slug!} locale="ja" />
