---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import {
  buildArticlePath,
  buildLegacyArticleSlug,
  buildTopicHrefFromLabel,
  findRelatedArticles,
  getArticleCustomSlug,
  getArticleDescription,
  getArticleDisplayTitle,
  getArticleId,
  getArticleSeoTitle,
  loadArticles,
} from "../../lib/articles";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.flatMap((article) => {
    const articleId = getArticleId(article);
    const canonicalSlug = buildArticlePath(article).split("/").filter(Boolean).pop()!;
    const displayTitle = getArticleDisplayTitle(article);
    const legacyTitleSlug = buildLegacyArticleSlug(displayTitle, articleId);
    const explicitSlug = getArticleCustomSlug(article);
    const explicitSlugWithId = explicitSlug
      ? buildLegacyArticleSlug(explicitSlug, articleId)
      : undefined;
    const routeSlugs = Array.from(
      new Set(
        [canonicalSlug, explicitSlugWithId, legacyTitleSlug, articleId].filter(Boolean)
      )
    );

    return routeSlugs.map((routeSlug) => ({
      params: { slug: routeSlug },
      props: { entryId: articleId, isLegacyRoute: routeSlug !== canonicalSlug },
    }));
  });
}

const { entryId, isLegacyRoute = false } = Astro.props;
const allArticles = await loadArticles();
const article = entryId
  ? allArticles.find((entry) => getArticleId(entry) === String(entryId).toLowerCase())
  : undefined;

if (!article) {
  throw new Error("記事が見つかりません。");
}

const { data } = article;
const relatedArticles = findRelatedArticles(article, allArticles);
const displayTitle = getArticleDisplayTitle(article);
const seoTitle = getArticleSeoTitle(article);
const canonicalPath = buildArticlePath(article);
const total = data.sections.length;
const minutes = Math.max(1, Math.round(data.durationSec / 60));

const formatMmss = (seconds: number) => {
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
};

const youtubeUrl = (time: number) => `https://youtu.be/${data.videoId}?t=${time}`;
const localThumbnail = withBase(`/images/${data.videoId}/thumbnail.webp`);
const headerImageSrc = withBase(data.headerImage);
const heroImageSrc = withBase(data.heroImage ?? data.headerImage);
const articleDescription = getArticleDescription(article);
const chipStyles = [
  "border-coral/40 bg-coral/10 text-coralDark",
  "border-teal/40 bg-teal/10 text-teal",
  "border-sky/50 bg-sky/15 text-ink/80",
  "border-salmon/40 bg-salmon/10 text-salmon",
  "border-sun/50 bg-sun/15 text-ink/80",
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: seoTitle,
  description: articleDescription,
  image: [`https://www.claude-daily.com${heroImageSrc}`],
  datePublished: data.fetchedAt.toISOString(),
  dateModified: data.fetchedAt.toISOString(),
  inLanguage: "ja",
  author: {
    "@type": "Organization",
    name: "Claude Daily",
  },
  publisher: {
    "@type": "Organization",
    name: "Claude Daily",
    logo: {
      "@type": "ImageObject",
      url: "https://www.claude-daily.com/logo.png",
    },
  },
  mainEntityOfPage: `https://www.claude-daily.com${canonicalPath}`,
  isBasedOn: `https://youtu.be/${data.videoId}`,
};
---

<BaseLayout
  title={`${seoTitle} | Claude Daily`}
  description={articleDescription}
  path={canonicalPath}
  image={heroImageSrc}
  type="article"
  publishedTime={data.fetchedAt.toISOString()}
  noindex={isLegacyRoute}
  structuredData={structuredData}
>
  <article class="mx-auto max-w-[74rem] space-y-12 xl:max-w-[72rem]">
    <section class="overflow-hidden rounded-slide border border-line/70 bg-paper shadow-slide">
      <div class="space-y-0">
        <div class="border-b border-line/60 px-6 py-6 md:px-8 md:py-8 xl:px-9">
          <div class="flex flex-wrap items-center gap-3 text-[0.7rem] uppercase tracking-[0.22em] text-clay">
            <span class="truncate">{data.channel}</span>
            <span aria-hidden="true">·</span>
            <time>{data.fetchedAt.toLocaleDateString("ja-JP")}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes}分の動画</span>
            <span aria-hidden="true">·</span>
            <span>{total} slides</span>
          </div>
          <h1 class="headline mt-5 text-[1.65rem] font-black leading-[1.32] text-ink sm:text-[2rem] sm:leading-[1.18] md:text-[2.45rem] md:leading-[1.14] xl:max-w-[56rem] xl:text-[2.9rem]">{displayTitle}</h1>
          <div class="mt-5 flex flex-wrap items-center gap-2">
            {data.keyPhrases.map((phrase, i) => (
            <a
              href={withBase(buildTopicHrefFromLabel(phrase))}
                class={`rounded-full border px-2.5 py-0.5 text-xs transition hover:-translate-y-0.5 hover:shadow-sm ${chipStyles[i % chipStyles.length]}`}
              >
                #{phrase}
              </a>
            ))}
          </div>
        </div>
        <div class="relative">
          <img src={heroImageSrc} alt={data.title} class="aspect-video w-full object-cover object-center" />
          <div class="absolute bottom-3 right-3 flex items-center gap-2 rounded-full bg-ink/70 px-3 py-1.5 text-[0.7rem] font-semibold text-paper backdrop-blur-sm md:bottom-4 md:right-4 md:gap-3 md:px-4 md:py-2 md:text-xs">
            <span>{data.viewCount.toLocaleString("ja-JP")} views</span>
            <span class="text-paper/40" aria-hidden="true">·</span>
            <span>{data.bulletPoints.length} highlights</span>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-slide border border-line/70 bg-paper p-8 shadow-card md:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">TL;DR · この記事で分かること</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {data.bulletPoints.map((point, index) => (
          <li class="rounded-2xl bg-cream/70 p-5">
            <div class="flex items-start gap-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-coral text-sm font-bold text-paper">{index + 1}</span>
              <span class="leading-[1.9] text-ink/85">{point.text}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-10">
      <div>
        <div class="flex items-baseline justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">スライドで読む</p>
          <p class="text-xs text-clay">全 {total} スライド</p>
        </div>
        <nav class="mt-5 flex gap-2 overflow-x-auto pb-2" aria-label="タイムライン">
          {data.sections.map((section, index) => (
            <a
              href={`#slide-${index + 1}`}
              class="group flex shrink-0 items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 text-xs text-clay transition hover:border-coral hover:text-ink"
            >
              <span class="font-bold text-coral">{String(index + 1).padStart(2, "0")}</span>
              <span class="text-[0.7rem] uppercase tracking-[0.18em]">{formatMmss(section.time)}</span>
              <span class="max-w-[10rem] truncate text-ink/75 group-hover:text-ink">{section.heading}</span>
            </a>
          ))}
        </nav>
      </div>

      {data.sections.map((section, index) => (
        <SectionBlock
          section={section}
          index={index + 1}
          total={total}
          timeLabel={formatMmss(section.time)}
          youtubeUrl={youtubeUrl(section.time)}
        />
      ))}
    </section>

    <section class="rounded-slide border border-line/70 bg-paper p-8 shadow-card md:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-clay">出典</p>
      <div class="mt-5 grid gap-6 md:grid-cols-[1fr_1.4fr] md:items-center">
        <a href={`https://youtu.be/${data.videoId}`} target="_blank" rel="noreferrer" class="block overflow-hidden rounded-2xl border border-line bg-cream">
          <img src={localThumbnail} alt={data.title} class="aspect-video w-full object-cover" onerror={`this.onerror=null; this.src='${headerImageSrc}'`} />
        </a>
        <div class="space-y-3">
          <p class="text-[0.7rem] uppercase tracking-[0.22em] text-clay">{data.channel}</p>
          <h3 class="headline text-xl font-bold leading-snug text-ink">{data.title}</h3>
          <div class="flex flex-wrap gap-4 text-xs text-clay">
            <span>動画公開日 {data.publishedAt.toLocaleDateString("ja-JP")}</span>
            <span>{minutes}分</span>
            <span>{data.viewCount.toLocaleString("ja-JP")} 回再生</span>
          </div>
          <p class="text-sm leading-[1.95] text-ink/75">
            この記事はYouTube動画の字幕をもとにClaudeで自動要約しています。細部のニュアンスや正確な発言は元動画をご参照ください。
          </p>
          <a
            href={`https://youtu.be/${data.videoId}`}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-coral px-5 py-2.5 text-sm font-semibold text-paper transition hover:bg-coralDark"
          >
            YouTubeで視聴する
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {relatedArticles.length > 0 && (
      <section class="rounded-slide border border-line/70 bg-paper p-8 shadow-card md:p-10">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">関連記事</p>
          <p class="text-xs text-clay">{relatedArticles.length} 件</p>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {relatedArticles.map((related) => (
            <a
              href={withBase(buildArticlePath(related))}
              class="group overflow-hidden rounded-2xl border border-line/70 bg-cream/40 transition hover:-translate-y-0.5 hover:border-coral/40 hover:bg-cream"
            >
              <img
                src={withBase(related.data.headerImage)}
                alt={related.data.articleTitle ?? related.data.title}
                class="aspect-video w-full object-cover object-center"
              />
              <div class="space-y-3 p-5">
                <p class="text-[0.7rem] uppercase tracking-[0.2em] text-clay">{related.data.channel}</p>
                <h3 class="headline line-clamp-3 text-lg font-bold leading-snug text-ink group-hover:text-coralDark">
                  {related.data.articleTitle ?? related.data.title}
                </h3>
                <p class="line-clamp-3 text-sm leading-7 text-ink/75">
                  {related.data.bulletPoints[0]?.text}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
