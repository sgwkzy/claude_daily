---
import { getCollection } from "astro:content";
import ArticleView from "../../components/ArticleView.astro";
import {
  buildArticlePath,
  buildLegacyArticleSlug,
  getArticleCustomSlug,
  getArticleDisplayTitle,
  getArticleId,
  loadArticles,
} from "../../lib/articles";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.flatMap((article) => {
    const articleId = getArticleId(article);
    const canonicalSlug = buildArticlePath(article).split("/").filter(Boolean).pop()!;
    const displayTitle = getArticleDisplayTitle(article);
    const legacyTitleSlug = buildLegacyArticleSlug(displayTitle, articleId);
    const explicitSlug = getArticleCustomSlug(article);
    const explicitSlugWithId = explicitSlug
      ? buildLegacyArticleSlug(explicitSlug, articleId)
      : undefined;
    const routeSlugs = Array.from(
      new Set(
        [canonicalSlug, explicitSlugWithId, legacyTitleSlug, articleId].filter(Boolean)
      )
    );

    return routeSlugs.map((routeSlug) => ({
      params: { slug: routeSlug },
      props: { entryId: articleId, isLegacyRoute: routeSlug !== canonicalSlug },
    }));
  });
}

const { entryId, isLegacyRoute = false } = Astro.props;
const allArticles = await loadArticles();
const article = entryId
  ? allArticles.find((entry) => getArticleId(entry) === String(entryId).toLowerCase())
  : undefined;

if (!article) {
  throw new Error("Article not found.");
}
---

<ArticleView article={article} locale="en" isLegacyRoute={isLegacyRoute} />
