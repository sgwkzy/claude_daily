---
import BaseLayout from "../layouts/BaseLayout.astro";
import DailyView from "../components/DailyView.astro";
import { loadDailyGroups, resolveDay } from "../lib/articles";

const groups = await loadDailyGroups();
const latest = groups[0];
const day = latest ? resolveDay(groups, latest.date) : undefined;
const allDates = groups.map((g) => g.date);
const latestArticle = day?.articles[0];
const pageDescription =
  "Claude・Claude Code・Anthropic・MCPに関するYouTube動画を毎日収集し、日本語で要点だけ読めるダイジェストにまとめます。AIエージェント・LLMの最新トピックを短時間でキャッチアップできます。";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Claude Daily",
  url: "https://www.claude-daily.com/",
  inLanguage: "ja",
  description: pageDescription,
};
---

<BaseLayout
  title="Claude Daily｜Claude・Claude Code・Anthropic・MCPの毎日ダイジェスト"
  description={pageDescription}
  path="/"
  image={latestArticle?.data.headerImage}
  structuredData={structuredData}
>
  {day ? (
    <DailyView day={day} totalDays={groups.length} allDates={allDates} latestDate={latest!.date} />
  ) : (
    <section class="rounded-slide border border-line/70 bg-paper p-10 text-center shadow-card">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">ブリーフ準備中</p>
      <p class="mt-3 text-lg text-ink/75">まだ記事がありません。バッチを実行すると記事がここに表示されます。</p>
    </section>
  )}
</BaseLayout>
