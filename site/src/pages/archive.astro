---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  buildArticlePath,
  buildTopicHrefFromLabel,
  formatDateLabel,
  formatShortDate,
  getArticleDisplayTitle,
  getArticleId,
  loadDailyGroups,
  loadTopicGroups,
} from "../lib/articles";
import { withBase } from "../lib/url";

const groups = await loadDailyGroups();
const topics = await loadTopicGroups();
const totalArticles = groups.reduce((sum, g) => sum + g.articles.length, 0);

// フィルタ用に文字列を正規化（NFKC + 小文字）する。
const normalize = (value: string): string => value.normalize("NFKC").toLowerCase();

// 絞り込みUI用のタグ（出現頻度順）。上位を表示する。
const featuredTags = topics.slice(0, 30);

const description =
  "Claude Daily の過去記事アーカイブ。Claude・Claude Code・Anthropic・MCP に関する全要約記事を日付ごとに一覧し、タイトルやタグでその場で絞り込めます。";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "アーカイブ | Claude Daily",
  url: "https://www.claude-daily.com/archive/",
  inLanguage: "ja",
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "Claude Daily",
    url: "https://www.claude-daily.com/",
  },
};
---

<BaseLayout
  title="アーカイブ（過去記事一覧） | Claude Daily"
  description={description}
  path="/archive/"
  structuredData={structuredData}
>
  <article class="mx-auto max-w-[74rem] space-y-10">
    <header class="rounded-slide border border-line/70 bg-paper p-8 shadow-card md:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">Archive</p>
      <h1 class="headline mt-4 text-3xl font-black leading-tight text-ink md:text-5xl">過去記事アーカイブ</h1>
      <p class="mt-4 max-w-3xl text-lg leading-[1.9] text-ink/75">
        これまでに公開した全 {totalArticles} 本の要約記事を日付ごとに一覧できます。
        タイトルやタグで絞り込んで、気になる記事を探せます。
      </p>

      <div class="mt-6 space-y-4">
        <div class="relative">
          <input
            id="archive-search"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="タイトル・タグで絞り込み"
            aria-label="記事をタイトルやタグで絞り込み"
            class="w-full rounded-full border border-line/70 bg-cream/40 px-5 py-3 text-base text-ink shadow-inner outline-none transition placeholder:text-clay focus:border-coral/50 focus:bg-paper"
          />
        </div>

        {featuredTags.length > 0 && (
          <div>
            <p class="text-[0.65rem] uppercase tracking-[0.28em] text-clay">タグで絞り込み</p>
            <div id="archive-tags" class="mt-3 flex flex-wrap gap-2">
              {featuredTags.map((tag) => (
                <button
                  type="button"
                  class="archive-tag rounded-full border border-line/70 bg-paper px-3 py-1.5 text-sm text-ink transition hover:border-coral/40 hover:bg-cream aria-pressed:border-coral aria-pressed:bg-coral aria-pressed:text-paper"
                  data-tag={normalize(tag.label)}
                  aria-pressed="false"
                >
                  {tag.label}
                  <span class="ml-1 text-xs text-clay aria-pressed:text-paper/80">{tag.articles.length}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <p id="archive-count" class="text-xs text-clay" aria-live="polite">全 {totalArticles} 件</p>
      </div>
    </header>

    <div id="archive-list" class="space-y-10">
      {groups.map((group) => (
        <section class="archive-day rounded-slide border border-line/70 bg-paper p-6 shadow-card md:p-8" data-date={group.date}>
          <h2 class="headline text-xl font-bold text-ink md:text-2xl">{formatDateLabel(group.date)}</h2>
          <ul class="mt-5 space-y-3">
            {group.articles.map((article) => {
              const title = getArticleDisplayTitle(article);
              const tags = article.data.keyPhrases ?? [];
              return (
                <li
                  class="archive-card rounded-[1.5rem] border border-line/60 bg-cream/30 p-5 transition hover:border-coral/40 hover:bg-cream"
                  data-title={normalize(title)}
                  data-tags={tags.map((t) => normalize(t)).join("|")}
                  data-id={getArticleId(article)}
                >
                  <div class="flex flex-col gap-2">
                    <a href={withBase(buildArticlePath(article))} class="group">
                      <span class="text-[0.65rem] uppercase tracking-[0.2em] text-clay">{formatShortDate(group.date)}</span>
                      <h3 class="headline mt-1 text-lg font-bold leading-snug text-ink group-hover:text-coralDark">{title}</h3>
                    </a>
                    {tags.length > 0 && (
                      <div class="mt-1 flex flex-wrap gap-1.5">
                        {tags.map((tag) => (
                          <a
                            href={withBase(buildTopicHrefFromLabel(tag))}
                            class="rounded-full bg-paper px-2.5 py-0.5 text-xs font-medium text-clay transition hover:text-coral"
                          >
                            {tag}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <section
      id="archive-empty"
      hidden
      class="rounded-slide border border-line/70 bg-paper p-10 text-center shadow-card"
    >
      <p class="text-lg text-ink/75">条件に一致する記事がありません。</p>
      <p class="mt-2 text-sm text-clay">検索語やタグの選択を変えてみてください。</p>
    </section>
  </article>

  <script>
    const search = document.getElementById("archive-search") as HTMLInputElement | null;
    const tagContainer = document.getElementById("archive-tags");
    const countEl = document.getElementById("archive-count");
    const emptyEl = document.getElementById("archive-empty");
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".archive-card"));
    const days = Array.from(document.querySelectorAll<HTMLElement>(".archive-day"));
    const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".archive-tag"));
    const total = cards.length;

    const normalize = (value: string): string => value.normalize("NFKC").toLowerCase();

    const activeTags = new Set<string>();

    const apply = () => {
      const query = normalize(search?.value.trim() ?? "");
      let visible = 0;

      for (const card of cards) {
        const title = card.dataset.title ?? "";
        const tags = (card.dataset.tags ?? "").split("|").filter(Boolean);
        const haystack = `${title} ${tags.join(" ")}`;

        const matchesQuery = query === "" || haystack.includes(query);
        const matchesTags =
          activeTags.size === 0 || Array.from(activeTags).every((t) => tags.includes(t));

        const show = matchesQuery && matchesTags;
        card.hidden = !show;
        if (show) visible += 1;
      }

      // 配下に可視カードが無い日付セクションは見出しごと隠す。
      for (const day of days) {
        const hasVisible = day.querySelector<HTMLElement>(".archive-card:not([hidden])");
        day.hidden = !hasVisible;
      }

      if (countEl) {
        countEl.textContent =
          visible === total ? `全 ${total} 件` : `${visible} / ${total} 件`;
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
    };

    search?.addEventListener("input", apply);

    tagContainer?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".archive-tag");
      if (!button) return;
      const tag = button.dataset.tag ?? "";
      if (!tag) return;

      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        button.setAttribute("aria-pressed", "false");
      } else {
        activeTags.add(tag);
        button.setAttribute("aria-pressed", "true");
      }
      apply();
    });

    apply();
  </script>
</BaseLayout>
