---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildTopicHref, loadTopicGroups } from "../../lib/articles";
import { withBase } from "../../lib/url";

const topics = await loadTopicGroups();
const featuredTopics = topics.slice(0, 24);
const description =
  "Claude Daily のトピック一覧。Claude、Anthropic、MCP まわりの話題をキーフレーズ単位でまとめて辿れます。";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "トピック一覧 | Claude Daily",
  url: "https://www.claude-daily.com/topics/",
  inLanguage: "ja",
  description,
};
---

<BaseLayout
  title="トピック一覧 | Claude Daily"
  description={description}
  path="/topics/"
  structuredData={structuredData}
>
  <article class="mx-auto max-w-[74rem] space-y-10">
    <header class="rounded-slide border border-line/70 bg-paper p-8 shadow-card md:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">Topics</p>
      <h1 class="headline mt-4 text-3xl font-black leading-tight text-ink md:text-5xl">話題ごとに追えるトピック一覧</h1>
      <p class="mt-4 max-w-3xl text-lg leading-[1.9] text-ink/75">
        記事に付いているキーフレーズをもとに、関連する動画要約をまとめています。
        気になる論点だけを横断して追いたいときに使えます。
      </p>
    </header>

    <section class="rounded-slide border border-line/70 bg-paper p-8 shadow-card md:p-10">
      <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-coral">Featured Topics</p>
        <p class="text-xs text-clay">全 {topics.length} トピック</p>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {featuredTopics.map((topic) => (
          <a
            href={withBase(buildTopicHref(topic.slug))}
            class="group rounded-[1.75rem] border border-line/70 bg-cream/40 p-5 transition hover:-translate-y-0.5 hover:border-coral/40 hover:bg-cream"
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="headline text-xl font-bold leading-snug text-ink group-hover:text-coralDark">{topic.label}</h2>
              <span class="rounded-full bg-paper px-3 py-1 text-xs font-semibold text-clay">{topic.articles.length}本</span>
            </div>
            <p class="mt-4 line-clamp-3 text-sm leading-7 text-ink/75">
              {topic.articles[0]?.data.bulletPoints[0]?.text}
            </p>
            <p class="mt-4 text-xs uppercase tracking-[0.22em] text-clay">
              最新: {topic.articles[0]?.data.channel}
            </p>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
