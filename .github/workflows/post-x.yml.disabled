name: Post New Articles to X

on:
  push:
    branches: [main]
    paths:
      - "site/src/content/articles/*.md"
  workflow_dispatch:

jobs:
  post:
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - name: リポジトリを取得
        uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - name: 新規追加された記事を検出
        id: detect
        run: |
          set -e
          NEW_FILES=$(git diff --name-only --diff-filter=A HEAD^ HEAD -- 'site/src/content/articles/*.md' | tr '\n' ' ')
          echo "新規追加された記事ファイル: $NEW_FILES"
          echo "files=$NEW_FILES" >> "$GITHUB_OUTPUT"

      - name: Python をセットアップ
        if: steps.detect.outputs.files != ''
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: 依存関係をインストール
        if: steps.detect.outputs.files != ''
        run: pip install tweepy PyYAML

      - name: X に投稿
        if: steps.detect.outputs.files != ''
        env:
          X_API_KEY: ${{ secrets.X_API_KEY }}
          X_API_SECRET: ${{ secrets.X_API_SECRET }}
          X_ACCESS_TOKEN: ${{ secrets.X_ACCESS_TOKEN }}
          X_ACCESS_TOKEN_SECRET: ${{ secrets.X_ACCESS_TOKEN_SECRET }}
        run: python batch/post_new_articles.py ${{ steps.detect.outputs.files }}
